#!/bin/sh
# Install the native client and SSH host for the current macOS user.
set -eu
[ "$(uname -s)" = Darwin ] || { echo 'Run bin/install-macos on the Mac.' >&2; exit 1; }
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
# Homebrew's bin directory is absent from the usual SSH PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$PATH"
GLIFF_DEST_APP="$HOME/Applications/Gliff.app"
# Reuse the certificate chosen for this installation across future builds.
# A fingerprint avoids ambiguous certificate names and needs no XML escaping.
GLIFF_SIGNING_IDENTITY="${GLIFF_CODESIGN_IDENTITY:-$(/usr/libexec/PlistBuddy -c 'Print :GliffSigningIdentity' "$GLIFF_DEST_APP/Contents/Info.plist" 2>/dev/null || printf '-')}"
case "$GLIFF_SIGNING_IDENTITY" in
    -) ;;
    *[!a-fA-F0-9]*|'') echo 'GLIFF_CODESIGN_IDENTITY must be a certificate SHA-1 fingerprint.' >&2; exit 1 ;;
    *) [ "${#GLIFF_SIGNING_IDENTITY}" -eq 40 ] || { echo 'Invalid signing fingerprint.' >&2; exit 1; } ;;
esac
mkdir -p "$HOME/Applications" "$HOME/.local/bin"
GLIFF_STAGE=$(mktemp -d "$HOME/Applications/.gliff-install.XXXXXX")
cleanup() {
    if [ -d "$GLIFF_STAGE/previous.app" ] && [ ! -e "$GLIFF_DEST_APP" ]; then
        mv "$GLIFF_STAGE/previous.app" "$GLIFF_DEST_APP"
    fi
    rm -rf "$GLIFF_STAGE"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
GLIFF_APP="$GLIFF_STAGE/Gliff.app"
GLIFF_CODESIGN_IDENTITY="$GLIFF_SIGNING_IDENTITY" bin/build-macos-app "$GLIFF_APP"
if [ -e "$GLIFF_DEST_APP" ]; then
    mv "$GLIFF_DEST_APP" "$GLIFF_STAGE/previous.app"
fi
mv "$GLIFF_APP" "$GLIFF_DEST_APP"
GLIFF_APP="$GLIFF_DEST_APP"
for name in gliff gliff-server; do
    ln -sfn "$GLIFF_APP/Contents/MacOS/$name" "$HOME/.local/bin/$name"
done
printf 'Installed %s\n' "$GLIFF_APP"
printf 'Enable hosting with: %s --permissions --request\n' "$GLIFF_APP/Contents/MacOS/gliff-server"
if [ "$GLIFF_SIGNING_IDENTITY" = - ]; then
    printf 'Ad-hoc signing changes the permission identity on rebuild. Set GLIFF_CODESIGN_IDENTITY to a development certificate fingerprint to keep grants across updates.\n'
fi
