#!/bin/sh
# Install the native client and SSH host for the current macOS user.
#= Builds from this checkout, unless the installed app already is this build
#= (same commit, no uncommitted changes, same architecture and signing
#= identity, signature intact): then it only refreshes the ~/.local/bin links.
#= GLIFF_FORCE=1 (make install FORCE=1) always rebuilds.
#= Version: 2.0.0
set -eu
[ "$(uname -s)" = Darwin ] || { echo 'Run bin/install-macos on the Mac.' >&2; exit 1; }
ROOT="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
# Homebrew's bin directory is absent from the usual SSH PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$PATH"
. "$ROOT/bin/lib/macos-install.sh"
# Reuse the certificate chosen for this installation across future builds;
# see gliff_pick_identity for the order.
gliff_pick_identity
GLIFF_BUILD_ID=$(gliff_build_id "$ROOT")
if [ "${GLIFF_FORCE:-0}" != 1 ] && gliff_installed_is "$GLIFF_BUILD_ID" "$GLIFF_SIGNING_IDENTITY"; then
    mkdir -p "$HOME/.local/bin"
    for name in gliff gliff-server; do
        ln -sfn "$GLIFF_DEST_APP/Contents/MacOS/$name" "$HOME/.local/bin/$name"
    done
    printf 'Gliff %s is already installed at %s; nothing to build (FORCE=1 rebuilds).\n' "$GLIFF_BUILD_ID" "$GLIFF_DEST_APP"
    exit 0
fi
case "$GLIFF_BUILD_ID" in
    *-dirty+*) printf 'Building %s: uncommitted changes, so it cannot match an installed build.\n' "$GLIFF_BUILD_ID" ;;
    *) printf 'Building %s (installed: %s)\n' "$GLIFF_BUILD_ID" "$(gliff_plist_value "$GLIFF_DEST_APP" GliffBuildID | sed 's/^$/none/')" ;;
esac
mkdir -p "$HOME/Applications" "$HOME/.local/bin"
GLIFF_STAGE=$(mktemp -d "$HOME/Applications/.gliff-install.XXXXXX")
trap 'gliff_restore_previous "$GLIFF_STAGE"' EXIT
trap 'exit 1' HUP INT TERM
GLIFF_CODESIGN_IDENTITY="$GLIFF_SIGNING_IDENTITY" bin/build-macos-app "$GLIFF_STAGE/Gliff.app"
gliff_place_app "$GLIFF_STAGE/Gliff.app" "$GLIFF_STAGE"
gliff_after_install "$GLIFF_SIGNING_IDENTITY"
